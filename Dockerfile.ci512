FROM python:3.14.8-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libegl1 libgles2 libglib2.0-0 libportaudio2 libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MALLOC_ARENA_MAX=2 \
    DJANGO_SECRET_KEY=ci-only-not-a-production-key-0123456789-abcdefghijklmnopqrstuvwxyz \
    DJANGO_DEBUG=false RENDER=false DJANGO_SETTINGS_MODULE=scripts.render512_settings DB_NAME=restaurant_ci512 DB_USER=postgres \
    DB_PASSWORD=ci-disposable-only DB_HOST=127.0.0.1 DB_PORT=5432 \
    DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver \
    TABLE_SERVICE_ASSIGNMENTS_ENABLED=true TABLE_SERVICE_LIFECYCLE_ENABLED=true MEMBERSHIP_DISCOUNTS_ENABLED=true \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
COPY . .
RUN bash build.sh
CMD ["bash", "scripts/start_render512_probe.sh"]
